{
  "name": "codemirror-helix",
  "version": "0.6.0",
  "type": "module",
  "license": "MPL-2.0",
  "author": "Roberto Vidal",
  "description": "Helix bindings for CodeMirror",
  "keywords": [
    "code",
    "editor",
    "helix",
    "codemirror"
  ],
  "scripts": {
    "demo": "cd ../../apps/demo-cm6 && vite",
    "build": "./etc/build.sh",
    "build:test": "SKIP_TS=1 npm run build",
    "test": "wdio run ./wdio.conf.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "files": [
    "dist/*"
  ],
  "types": "./dist/lib.d.ts",
  "main": "./dist/lib.js",
  "exports": {
    "development": "./dist/lib.development.js",
    "default": "./dist/lib.js"
  },
  "sideEffects": false,
  "devDependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.0.0",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@ddietr/codemirror-themes": "^1.5.2",
    "@lezer/common": "^1.2.1",
    "@shoelace-style/shoelace": "^2.16.0",
    "@wdio/cli": "^9.27.2",
    "@wdio/local-runner": "^9.27.1",
    "@wdio/mocha-framework": "^9.27.1",
    "@wdio/spec-reporter": "^9.27.1",
    "esbuild": "^0.25.9",
    "typescript": "^6.0.3",
    "vite": "^7.3.2"
  },
  "dependencies": {
    "codemirror-helix-core": "0.1.0-alpha.1"
  },
  "peerDependencies": {
    "@codemirror/commands": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/search": "^6.2.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.22.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EastSun5566/codemirror-helix.git",
    "directory": "packages/codemirror-helix"
  }
}
